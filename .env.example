# =============================================================================
# Orbita — environment template (copy to apps/api/.env — never commit secrets)
# =============================================================================

# Server
PORT=3001
NODE_ENV=development
PUBLIC_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:*

# Supabase Auth (JWT verify + magic link / Google)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Database (Postgres — Supabase or Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/chatai

# Redis (rate limit + usage counters) — optional in local stub
REDIS_URL=redis://localhost:6379

# AI vendor — xAI Grok only (server-only — never ship to Flutter client)
XAI_API_KEY=your_xai_grok_api_key
XAI_BASE_URL=https://api.x.ai/v1
# Optional vendor model id overrides (defaults below)
# Pro (stronger) → grok-4.7; Free (lighter/cheaper) → grok-4.3
# Do not reuse retired ids (grok-3 / grok-3-mini) — they redirect or 404.
XAI_GROK_MODEL=grok-4.7
XAI_GROK_FAST_MODEL=grok-4.3
# Used when the user attaches images (vision / multimodal). Grok-only.
# Free (grok-fast) image chats also use this — do not point at deleted ids.
XAI_GROK_VISION_MODEL=grok-4.7

# Web search (server-side; automatic tool use — no client toggle required)
# xai   = xAI Responses API built-in web_search (default; needs XAI_API_KEY only)
# local = client-side web_search tool via DuckDuckGo (free) or Brave
# off   = disable live search
XAI_WEB_SEARCH_MODE=xai
WEB_SEARCH_TIMEOUT_MS=90000
WEB_SEARCH_MAX_TOOL_ROUNDS=3
# Optional — when set, local mode prefers Brave Search over DuckDuckGo
# BRAVE_SEARCH_API_KEY=

# Microsoft Store billing (Store-managed subscription / IAP — NOT Stripe)
# Partner Center: create Subscription add-on (e.g. pro_monthly) at $9.99/mo + optional 7-day trial.
# Azure AD app + Partner Center service access for Collections / Purchase API.
MS_STORE_TENANT_ID=your_azure_ad_tenant_id
MS_STORE_CLIENT_ID=your_azure_ad_app_client_id
MS_STORE_CLIENT_SECRET=your_azure_ad_app_client_secret
MS_STORE_PRO_PRODUCT_ID=pro_monthly
# Optional overrides
# MS_STORE_COLLECTIONS_BASE_URL=https://collections.mp.microsoft.com/v7.0
# MS_STORE_COLLECTIONS_SCOPE=https://onestore.microsoft.com/.default

# Quotas (tunable knobs — defaults match product plan)
FREE_MESSAGES_PER_DAY=60
PRO_MESSAGES_PER_DAY=400
FREE_TOKEN_SOFT_CAP_PER_DAY=80000
PRO_TOKEN_SOFT_CAP_PER_DAY=800000
FREE_RATE_LIMIT_PER_MIN=5
PRO_RATE_LIMIT_PER_MIN=30
FREE_IMAGES_PER_MESSAGE=3
PRO_IMAGES_PER_MESSAGE=8
FREE_MAX_IMAGE_BYTES=5242880
MAX_IMAGE_BYTES=8388608
FREE_IMAGES_PER_DAY=8
PRO_IMAGES_PER_DAY=20
# Hidden Pro soft-cap (not marketed): after this many images in the UTC month,
# Pro image limits reduce to Free (3/msg + 8/day + 5 MB) until next month.
PRO_IMAGES_PER_MONTH_SOFT_CAP=200

# Flutter client (build-time / dart-define — public values only)
# SUPABASE_URL and SUPABASE_ANON_KEY above are also used by the Windows app.
# API_BASE_URL for local: http://localhost:3001
# MS_STORE_PRO_PRODUCT_ID can also be passed as dart-define (must match Partner Center).
API_BASE_URL=http://localhost:3001
