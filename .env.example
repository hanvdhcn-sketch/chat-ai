# =============================================================================
# Orbita API — environment template.
# Local dev: copy to apps/api/.env.   Production: set these as host secrets
# (see docs/deploy-fly.md). Never commit real values.
# Lines marked [REQUIRED IN PRODUCTION] stop the API from booting if empty.
# =============================================================================

# --- Server -------------------------------------------------------------------
PORT=3001
# production → stub auth is impossible and the required values below are enforced.
NODE_ENV=development
PUBLIC_API_URL=http://localhost:3001
# Desktop app does not use CORS; leave unset in production.
# CORS_ORIGIN=

# --- Auth: Supabase -----------------------------------------------------------
# Dashboard → Project Settings → API.
# [REQUIRED IN PRODUCTION] project URL (also lets the API fetch the JWKS for
# asymmetric ES256/RS256 access tokens).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Public anon key — only used by the Windows client build (-SupabaseAnonKey).
SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Not used by the API today; keep out of the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Legacy HS256 JWT secret (Project Settings → API → JWT Secret). Needed only if
# your project still signs access tokens with HS256 (the default for older projects).
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Dev-only fallback: accept `Bearer stub:<userId>:<free|pro>` tokens.
# Ignored (and the API refuses to boot) when NODE_ENV=production.
# Stub ids are not Supabase uuids, so run without DATABASE_URL when using this.
# ALLOW_DEV_STUB_AUTH=true

# --- Database: Supabase Postgres (persists Store entitlements → Pro) ----------
# [REQUIRED IN PRODUCTION] Dashboard → Connect → "Session pooler" URI, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Leave unset for local dev: entitlements then live in memory only.
# DATABASE_URL=
# require (default) | disable (plain local Postgres)
# DATABASE_SSL=require

# Reserved (not used yet)
# REDIS_URL=redis://localhost:6379

# --- AI vendor: xAI Grok only (server-only — never ship to the Flutter client) -
# [REQUIRED IN PRODUCTION]
XAI_API_KEY=your_xai_grok_api_key
XAI_BASE_URL=https://api.x.ai/v1
# Optional vendor model id overrides (defaults = recommended constants in model-catalog.ts)
# Free → logical grok-fast → XAI_GROK_FAST_MODEL (default grok-4.3, cheaper)
# Pro  → logical grok      → XAI_GROK_MODEL (default = current flagship stable, e.g. grok-4.7)
# xAI has no cross-family “always strongest” alias — when a new flagship ships, set
# XAI_GROK_MODEL (and usually XAI_GROK_VISION_MODEL) then redeploy. No code change required.
# Do not invent fake ids; do not reuse retired ids (grok-3 / grok-3-mini).
XAI_GROK_MODEL=grok-4.7
XAI_GROK_FAST_MODEL=grok-4.3
# Used when the user attaches images (vision / multimodal). Grok-only.
# Free (grok-fast) image chats also use this — do not point at deleted ids.
XAI_GROK_VISION_MODEL=grok-4.7

# Web search (server-side; automatic tool use — no client toggle required)
# xai   = xAI Responses API built-in web_search (default; needs XAI_API_KEY only)
# local = client-side web_search tool via DuckDuckGo (free) or Brave
# off   = disable live search
XAI_WEB_SEARCH_MODE=xai
WEB_SEARCH_TIMEOUT_MS=90000
WEB_SEARCH_MAX_TOOL_ROUNDS=3
# Optional — when set, local mode prefers Brave Search over DuckDuckGo
# BRAVE_SEARCH_API_KEY=

# --- Microsoft Store billing (Store-managed subscription / IAP — NOT Stripe) --
# Partner Center: subscription add-on `pro_monthly` ($9.99/mo + optional 7-day trial).
# Azure AD app registered for the Microsoft Store Collections API.
# [REQUIRED IN PRODUCTION] all four of the next values:
MS_STORE_TENANT_ID=your_azure_ad_tenant_id
MS_STORE_CLIENT_ID=your_azure_ad_app_client_id
MS_STORE_CLIENT_SECRET=your_azure_ad_app_client_secret
# Store ID (9XXXXXXXXXXX) of the pro_monthly add-on — Collections reports by Store ID.
MS_STORE_PRO_STORE_ID=
# In-app offer token of the add-on; must match the MSIX build (default pro_monthly).
MS_STORE_PRO_PRODUCT_ID=pro_monthly
# Optional overrides
# MS_STORE_COLLECTIONS_KEY_SCOPE=https://onestore.microsoft.com/b2b/keys/create/collections/.default
# MS_STORE_COLLECTIONS_BASE_URL=https://collections.mp.microsoft.com/v7.0
# MS_STORE_COLLECTIONS_SCOPE=https://onestore.microsoft.com/.default

# Deprecated Stripe names are accepted but unused (routes return 410):
# STRIPE_SECRET_KEY= / STRIPE_WEBHOOK_SECRET= / STRIPE_PRICE_PRO_MONTHLY=

# --- Quotas (tunable knobs — defaults match product plan) ---------------------
FREE_MESSAGES_PER_DAY=60
PRO_MESSAGES_PER_DAY=400
FREE_TOKEN_SOFT_CAP_PER_DAY=80000
PRO_TOKEN_SOFT_CAP_PER_DAY=800000
FREE_RATE_LIMIT_PER_MIN=5
PRO_RATE_LIMIT_PER_MIN=30
FREE_IMAGES_PER_MESSAGE=3
PRO_IMAGES_PER_MESSAGE=8
FREE_MAX_IMAGE_BYTES=5242880
MAX_IMAGE_BYTES=8388608
FREE_IMAGES_PER_DAY=8
PRO_IMAGES_PER_DAY=20
# Hidden Pro soft-cap (not marketed): after this many images in the UTC month,
# Pro image limits reduce to Free (3/msg + 8/day + 5 MB) until next month.
PRO_IMAGES_PER_MONTH_SOFT_CAP=200

# --- Windows client (build-time only; pass to scripts/build_store_msix.ps1) ---
# -ApiBaseUrl https://<your-api-host>  -SupabaseUrl <SUPABASE_URL>  -SupabaseAnonKey <SUPABASE_ANON_KEY>
# Local dev client: API_BASE_URL defaults to http://localhost:3001.
