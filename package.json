{
  "name": "chat-ai",
  "private": true,
  "version": "0.1.0",
  "description": "ChatAI — Windows MS Store chat app (Flutter) + Fastify API (Grok + Gemini)",
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @chatai/api",
